{
  "env": {
    "shellEnv": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash-lite"
      },
      "models": {
        "google/gemini-2.5-flash-lite": {
          "alias": "Gemini Flash Lite"
        }
      },
      "workspace": "/home/node/.openclaw/workspace"
    },
    "list": [
      {
        "id": "TARS",
        "default": true,
        "name": "Tars",
        "identity": {
          "name": "Tars"
        }
      }
    ]
  },
  "models": {
    "providers": {
      "google": {
        "apiKey": {
          "source": "env",
          "provider": "google",
          "id": "GEMINI_API_KEY"
        }
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "disabled",
      "tokenFile": "/home/node/.openclaw/secrets/telegram-bot-token",
      "groups": {
        "-1003857816777": {
          "requireMention": false,
          "allowFrom": [
            "265481906"
          ]
        }
      },
      "groupAllowFrom": [
        "265481906"
      ],
      "groupPolicy": "allowlist",
      "streaming": "partial"
    }
  },
  "gateway": {
    "mode": "local",
    "channelHealthCheckMinutes": 5,
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.3.14",
    "lastTouchedAt": "2026-03-25T18:22:43.950Z"
  }
}
